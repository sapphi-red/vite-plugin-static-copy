{
  "name": "vite-plugin-static-copy",
  "version": "4.1.1",
  "description": "rollup-plugin-copy for vite with dev server support.",
  "keywords": [
    "vite",
    "vite-plugin"
  ],
  "homepage": "https://github.com/sapphi-red/vite-plugin-static-copy#readme",
  "bugs": {
    "url": "https://github.com/sapphi-red/vite-plugin-static-copy/issues"
  },
  "license": "MIT",
  "author": "sapphi-red (https://github.com/sapphi-red)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sapphi-red/vite-plugin-static-copy.git"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/sapphi-red"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": "./dist/index.js",
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown",
    "lint": "oxlint",
    "format": "oxfmt",
    "test": "vitest",
    "release:version": "changeset version && pnpm install --no-frozen-lockfile",
    "release:publish": "changeset publish"
  },
  "dependencies": {
    "chokidar": "^3.6.0",
    "p-map": "^7.1.1",
    "picocolors": "^1.1.1",
    "tinyglobby": "^0.2.17"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@polka/url": "^1.0.0-next.29",
    "@types/node": "^22.20.5",
    "@types/throttle-debounce": "^5.0.2",
    "mrmime": "^2.0.1",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005",
    "throttle-debounce": "^5.0.2",
    "tsdown": "^0.23.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "vite": "^6.0.0 || ^7.0.0 || ^8.0.0"
  },
  "engines": {
    "node": "^22.0.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.25.0",
  "compatiblePackages": {
    "schemaVersion": 1,
    "rollup": {
      "type": "incompatible",
      "reason": "Uses Vite-specific APIs"
    },
    "rolldown": {
      "type": "incompatible",
      "reason": "Uses Vite-specific APIs"
    }
  }
}
